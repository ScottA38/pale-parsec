---
interface Props {
  title: string;
};
const {
  title,
} = Astro.props;

---
<header class="site header">
  <nav class="site navigation">
    <!-- <span class="site headings-container">
      <h1 class="site title">{ title }</h1>
      <h2 class="site subheading">
        <slot name="subheading" />
      </h2>
    </span> -->
    <slot name="default" />
  </nav>
</header>
<style lang="scss">
  @use "../styles/text.scss" as t;
  @keyframes slideaway {
    from { display: block; }
    to { transform: translateY(40px); opacity: 0;}
  }

  nav {
    display: grid;
    grid-column: 3 / span 1;
    grid-template-columns: repeat(3, minmax(0, 1fr));

   }

  header {
    background-color: black;
    nav {
      transition: display 200ms;
      animation: slideaway 200ms;
      display: none;
      opacity: 0;
    }
  }

  header:hover {
    nav {
      display: block;
      opacity: 1;
    }
  }

  // .splash-image {
  //   grid-column: 3 / span 1;
  //   background-size: cover;
  //   object-fit: contain;
  // }

  .site.header {
    display: grid;
    position: sticky;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    top: 0;
    left: 0;
    padding-bottom: 2rem;
    border-bottom: 1px ridge rgb(211 220 50 / 0.6) ;
    vertical-align: middle;
  }


  /** headings */
  .site.title {
    @include t.title-text;
    padding-left: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
    text-shadow: -3px 3px 0 hotpink;

    sub {
      padding-right: .5rem;
    }
  }

  span.headings-container {
    display: block;
    padding-left: 2rem;
    margin-bottom: 1.5rem;
  }

  .site.subheading {
    @include t.subheading-text 
  }
</style>
---
const { title } = Astro.props;
type NavConfigItem  = {
  link: string;
  label: string;
}
const navConfig: NavConfigItem[] = [
  {
    link: "/",
    label: "Home",
  },
  {
    link: "/band",
    label: "The Band",
  },
  {
    link: "/tour",
    label: "Tour",
  },
  {
    link: "/merch",
    label: "Merch",
  }
]
import { getImage } from "astro:assets";
import tornBillboard from '../torn-billboard-herr-loeffler.jpg';
let menuCounter = 0;

const optimizedBackground = await getImage({ src: tornBillboard, format: "webp" });
---

<header class="site header">
    <nav class="site navigation">
      <h1 class="site title">{ title }</h1>
      <ol class="site navigation list">
        {
          navConfig.map((configItem: NavConfigItem, index: number) => {
            const renderedLi = (<li class="crumb" style={`background-image: url(${optimizedBackground.src}); background-position: ${ (index * 10) }% 0%`}>
              <span class="highlight">
                <a class="nav link" href={ configItem.link }>{ configItem.label }</a>
              </span>
            </li>);

           return renderedLi 
          })
        };
      </ol>
    </nav>
</header>
<style>
  .site.header {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    padding-bottom: 2rem;
    border-bottom: 1px ridge rgb(211 220 50 / 0.6) ;
    vertical-align: middle;
  }

  .site.navigation {
    margin-right: 2rem;

    ol {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      list-style: decimal;

      .crumb {
        padding: 2rem;
        border-radius: 1rem;;
        /* display: inline-block; */
        color: white;
        text-align: right;

        a {
          font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
          color: black;
          text-decoration: none;
        }
      }
    }
  }

  h1.site.title {
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: white;
    text-align: left;
    padding-left: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .highlight {
    display: inline-block;
    padding: .25rem 0;
    color: rgb(211 220 50 / 0.6);
  }
</style>
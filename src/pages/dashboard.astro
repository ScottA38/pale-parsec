---
import SiteLayout from "../layouts/SiteLayout.astro";
import { createClerkClient, type User} from "@clerk/astro/server";
import { type ClerkClient } from "@clerk/backend";
const { isAuthenticated, userId, redirectToSignIn } = Astro.locals.auth();
if (!isAuthenticated) {
  return redirectToSignIn()
}

/** Component import */
import UserWelcome from "../components/UserWelcome";
import PostCard from "../components/dashboard/post-card";

/** Fetching blog updates */
const activeBlobs = await fetch(
  new URL('/api/updates.json', Astro.url),
  { method: 'GET' }
);
const activeBlobsJson = await activeBlobs.json();
const clerk = createClerkClient({
  publishableKey: import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY,
  secretKey: import.meta.env.CLERK_SECRET_KEY
});

async function getAuthorName(
  clerk: ClerkClient,
  blobJson: { content: { userId: string | null }} | undefined
): Promise<string> {
  const userId: string | null | undefined = blobJson?.content?.userId;
  const fallback = 'Unknown';
  if (!userId) {
    return fallback;
  }

  try {
    const author = await clerk.users.getUser(userId);
    if (author !== undefined && author.username !== null) {
      return author.username;
    }
  } catch (e) {
    console.error(`Failed to get User data for userId: ${userId}`);
  }

  return fallback;
}

async function extractBlobData(clerk: ClerkClient, blob: any) {
  const blobKey = Object.keys(blob)[0];
  const blobData : any = blob[blobKey];
  const authorName = await getAuthorName(clerk, blobData);

  return {
    title: blobData.content.title,
    subheading: blobData.content.subheading,
    authorName: authorName,
    date: blobData.content.date,
    body: blobData.content.body,
    image: blobData.content.image,
    tags: blobData.content.tags
  }
}
---

<SiteLayout>
  <UserWelcome client:load />
  {
    activeBlobsJson.map(async (blob: any) => {
      const { title, subheading = '', authorName, date, body, image, tags } = await extractBlobData(clerk, blob);
      return (<PostCard
        title={ title }
        subheading={ subheading }
        authorName={ authorName }
        date={ date }
        body={ body }
        images={ image }
        tags={ tags }
        client:load
      />)
    })
  }
</SiteLayout>
<style lang="scss">
  @use '../styles/text.scss' as t;
</style>
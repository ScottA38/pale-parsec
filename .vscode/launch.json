{
  "version": "0.2.0",
  "inputs": [],
  "configurations": [
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Development server",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "node --inspect-brk=9229 ./node_modules/astro/bin/astro.mjs dev",
      "name": "Astro server (Node debugger)",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "netlify dev",
      "name": "netlify server",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "npx vitest",
      "name": "test suite",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "name": "Attach to Node Process",
      "port": 9229,
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against Localhost",
      "url": "http://localhost:4321",
      "webRoot": "${workspaceFolder}/src",
      "sourceMapPathOverrides": {
        "vite:///src/*": "${webRoot}/*"
      },
      "skipFiles": [
        "**/node_modules/**"
      ]
    }
  ]
}
